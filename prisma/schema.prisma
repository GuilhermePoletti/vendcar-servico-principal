// Prisma Schema — Serviço Principal (db_principal)
// Gerado conforme GUIA_PROJETO.md e Skill 06

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum StatusVeiculo {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

enum RoleUsuario {
  ADMIN
  VENDEDOR
}

// ─────────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────────

model Marca {
  id           String    @id @default(uuid())
  nome         String    @unique
  criado_em    DateTime  @default(now())
  atualizado_em DateTime @updatedAt

  veiculos Veiculo[]

  @@map("marcas")
}

model Cliente {
  id           String    @id @default(uuid())
  nome         String
  cpf          String    @unique
  email        String
  criado_em    DateTime  @default(now())
  atualizado_em DateTime @updatedAt

  @@map("clientes")
}

model Veiculo {
  id           String        @id @default(uuid())
  id_marca     String
  modelo       String
  ano          Int
  cor          String
  preco        Decimal       @db.Decimal(12, 2)
  status       StatusVeiculo @default(DISPONIVEL)
  criado_em    DateTime      @default(now())
  atualizado_em DateTime     @updatedAt

  marca Marca @relation(fields: [id_marca], references: [id])

  @@map("veiculos")
}

model Usuario {
  id           String      @id @default(uuid())
  nome         String
  email        String      @unique
  senha_hash   String
  role         RoleUsuario @default(VENDEDOR)
  criado_em    DateTime    @default(now())
  atualizado_em DateTime   @updatedAt

  @@map("usuarios")
}
